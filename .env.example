# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings > API). .env.local is git-ignored. Never commit real keys.

# Project URL, for example https://abcdxyzcompany.supabase.co
VITE_SUPABASE_URL=

# Publishable (anon) key. Safe for the browser, protected by Row Level Security.
# Never put the service_role / secret key in any VITE_ variable.
VITE_SUPABASE_PUBLISHABLE_KEY=
